{
  "name": "storyteller",
  "version": "1.0.0",
  "description": "Simple Indonesian storytelling TTS workspace",
  "main": "index.js",
  "scripts": {
    "tts": "node scripts/generate-tts.mjs",
    "tts:voices": "edge-tts voice-list",
    "web": "node web/server.mjs",
    "train:profile": "node scripts/train-profile.mjs",
    "train:ml": "node scripts/train-ml-policy.mjs",
    "train:split": "node scripts/train-split.mjs",
    "eval:ml": "node scripts/eval-ml-policy.mjs",
    "train:auto": "node scripts/train-auto.mjs",
    "train:bootstrap": "node scripts/bootstrap-ml-data.mjs",
    "train:augment": "node scripts/augment-ml-data.mjs",
    "train:style-detail": "node scripts/enrich-style-feedback.mjs",
    "train:benchmark-all": "node scripts/generate-style-benchmarks.mjs",
    "train:dedupe": "node scripts/dedupe-training-data.mjs",
    "train:migrate-schema": "node scripts/migrate-feedback-schema.mjs",
    "train:self": "node scripts/self-train.mjs",
    "train:self:py": "node scripts/self-train.mjs --trainer py",
    "eval:expression": "node scripts/eval-auto-expression.mjs",
    "eval:expression-suite": "node scripts/eval-expression-suite.mjs",
    "eval:hybrid-ab": "node scripts/eval-hybrid-ab.mjs",
    "eval:expression-select": "node scripts/select-expression-default.mjs",
    "eval:voice-suite": "node scripts/eval-voice-character-suite.mjs",
    "train:ml:service": "node scripts/train-ml-policy-service.mjs",
    "bench:trainers": "node scripts/benchmark-trainers.mjs",
    "bench:trainers:seq": "powershell -ExecutionPolicy Bypass -File scripts/benchmark-trainers.ps1",
    "pack:export": "node scripts/export-training-pack.mjs",
    "pack:import": "node scripts/import-training-pack.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@andresaya/edge-tts": "^1.8.0",
    "adm-zip": "^0.5.16",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "ml-regression-multivariate-linear": "^2.0.4"
  }
}
