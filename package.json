{
  "name": "storyteller",
  "version": "1.0.0",
  "description": "Simple Indonesian storytelling TTS workspace",
  "main": "index.js",
  "scripts": {
    "tts": "python scripts_py/generate_tts.py --runtime py --input sample/sample_text_input.txt",
    "py:tts": "python scripts_py/generate_tts.py --input sample/sample_text_input.txt",
    "tts:voices": "edge-tts voice-list",
    "web": "node web/server.mjs",
    "train:profile": "python scripts_py/train_profile.py --feedback-source sqlite --db-file data/training/training.db",
    "py:train:profile": "python scripts_py/train_profile.py",
    "train:ml": "python scripts_py/train_ml_policy.py --feedback-source sqlite --db-file data/training/training.db",
    "train:limiter-policy": "python scripts_py/train_limiter_policy.py --feedback-source sqlite --db-file data/training/training.db",
    "eval:limiter:apply-policy": "python scripts_py/apply_limiter_policy_default.py",
    "py:train:ml": "python scripts_py/train_ml_policy.py",
    "py:train:limiter-policy": "python scripts_py/train_limiter_policy.py",
    "py:train:db": "python scripts_py/train.py --mode all --db-file data/training/training.db",
    "py:eval:limiter:apply-policy": "python scripts_py/apply_limiter_policy_default.py",
    "eval:ml": "python scripts_py/eval_ml_policy.py",
    "py:eval:ml": "python scripts_py/eval_ml_policy.py",
    "train:auto": "python scripts_py/train.py --mode all --db-file data/training/training.db",
    "py:train:auto": "python scripts_py/train.py --mode all --db-file data/training/training.db",
    "py:train:migrate-sqlite": "python scripts_py/migrate_training_to_sqlite.py",
    "train:self": "python scripts_py/self_train.py --trainer py --training-store sqlite",
    "train:self:loop": "python scripts_py/self_train_loop.py --trainer py --training-store sqlite",
    "py:train:self": "python scripts_py/self_train.py",
    "py:train:self:sqlite": "python scripts_py/self_train.py --trainer py --training-store sqlite",
    "py:train:self:loop": "python scripts_py/self_train_loop.py --trainer py",
    "train:self:py": "python scripts_py/self_train.py --trainer py --training-store sqlite",
    "py:train:self:py": "python scripts_py/self_train.py --trainer py --training-store sqlite",
    "py:train:self:py:loop": "python scripts_py/self_train_loop.py --trainer py",
    "eval:expression": "python scripts_py/eval_auto_expression.py",
    "py:eval:expression": "python scripts_py/eval_auto_expression.py",
    "eval:expression-suite": "python scripts_py/eval_expression_suite.py",
    "py:eval:expression-suite": "python scripts_py/eval_expression_suite.py",
    "eval:expression-ab": "python scripts_py/eval_expression_ab.py",
    "eval:expression-ab:apply": "python scripts_py/apply_expression_ab_default.py",
    "eval:hybrid-ab:apply": "python scripts_py/apply_hybrid_ab_default.py",
    "py:eval:expression-ab": "python scripts_py/eval_expression_ab.py",
    "py:eval:expression-ab:apply": "python scripts_py/apply_expression_ab_default.py",
    "eval:hybrid-ab": "python scripts_py/eval_hybrid_ab.py",
    "py:eval:hybrid-ab": "python scripts_py/eval_hybrid_ab.py",
    "py:eval:hybrid-ab:apply": "python scripts_py/apply_hybrid_ab_default.py",
    "eval:expression-select": "python scripts_py/select_expression_default.py",
    "eval:intonation:select": "python scripts_py/select_auto_intonation.py",
    "eval:limiter:select": "python scripts_py/select_prosody_limiter.py",
    "py:eval:expression-select": "python scripts_py/select_expression_default.py",
    "py:eval:intonation:select": "python scripts_py/select_auto_intonation.py",
    "py:eval:limiter:select": "python scripts_py/select_prosody_limiter.py",
    "eval:voice-suite": "python scripts_py/eval_voice_character_suite.py",
    "py:eval:voice-suite": "python scripts_py/eval_voice_character_suite.py",
    "train:ml:service": "python scripts_py/train_ml_policy_service.py",
    "py:train:ml:service": "python scripts_py/train_ml_policy_service.py",
    "bench:trainers": "python scripts_py/benchmark_trainers.py",
    "py:bench:trainers": "python scripts_py/benchmark_trainers.py",
    "bench:trainers:seq": "python scripts_py/benchmark_trainers_seq.py",
    "py:bench:trainers:seq": "python scripts_py/benchmark_trainers_seq.py",
    "pack:export": "python scripts_py/export_training_pack.py",
    "py:pack:export": "python scripts_py/export_training_pack.py",
    "pack:import": "python scripts_py/import_training_pack.py",
    "py:pack:import": "python scripts_py/import_training_pack.py",
    "py:bench:service-client": "python scripts_py/bench_service_client.py",
    "prod:train": "python scripts_py/train.py --mode all --db-file data/training/training.db",
    "prod:eval": "python scripts_py/eval_expression_ab.py && python scripts_py/eval_hybrid_ab.py && python scripts_py/eval_voice_character_suite.py && npm run py:eval:prosody-parity:strict && npm run eval:reference-match",
    "prod:apply": "python scripts_py/apply_expression_ab_default.py && python scripts_py/apply_hybrid_ab_default.py && python scripts_py/apply_limiter_policy_default.py && npm run tuning:apply:sample",
    "prod:pipeline": "npm run prod:train && npm run prod:eval && npm run prod:apply",
    "prod:pipeline:loop": "powershell -NoProfile -Command \"while ($true) { npm run prod:pipeline; if ($LASTEXITCODE -ne 0) { break }; Start-Sleep -Seconds 3 }\"",
    "js:tts": "node scripts/generate-tts.mjs",
    "py:eval:prosody-parity": "python scripts_py/contract_prosody_parity.py --dir tests/expressions --style tegang --humanize-intensity 0.55 --tolerance 12",
    "py:eval:prosody-parity:mid": "python scripts_py/contract_prosody_parity.py --dir tests/expressions --style tegang --humanize-intensity 0.55 --tolerance 5",
    "py:eval:prosody-parity:strict": "python scripts_py/contract_prosody_parity.py --dir tests/expressions --style tegang --humanize-intensity 0.55 --tolerance 2",
    "prod:eval:mid": "python scripts_py/eval_expression_ab.py && python scripts_py/eval_hybrid_ab.py && python scripts_py/eval_voice_character_suite.py && npm run py:eval:prosody-parity:mid && npm run eval:reference-match",
    "prod:eval:strict": "python scripts_py/eval_expression_ab.py && python scripts_py/eval_hybrid_ab.py && python scripts_py/eval_voice_character_suite.py && npm run py:eval:prosody-parity:strict && npm run eval:reference-match",
    "prod:eval:base": "python scripts_py/eval_expression_ab.py && python scripts_py/eval_hybrid_ab.py && python scripts_py/eval_voice_character_suite.py && npm run py:eval:prosody-parity && npm run eval:reference-match",
    "ci:quality-gate": "python scripts_py/ci_quality_gate.py",
    "tuning:apply:sample": "python scripts_py/apply_sample_tuning.py --sample sample/sample_text.json",
    "eval:reference-match": "python scripts_py/eval_reference_audio_match.py"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@andresaya/edge-tts": "^1.8.0",
    "adm-zip": "^0.5.16",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "ml-regression-multivariate-linear": "^2.0.4"
  }
}
